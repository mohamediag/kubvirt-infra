! Managed by kubevirt-infra (ansible/playbooks/host.yml). The host is the
! fabric: one passive eBGP peer group per workload cluster (vm_vlans), whose
! nodes connect from their VLAN. Inbound: only the cluster's pod CIDR (per-node
! blocks) and LoadBalancer /32s. Outbound: nothing, nodes route via their
! default gateway (this host).
frr defaults datacenter
hostname {{ inventory_hostname }}
log syslog informational
service integrated-vtysh-config
!
{% for t in vm_vlans %}
ip prefix-list {{ t.name }}-in seq 10 permit {{ t.pod_cidr }} le 32
ip prefix-list {{ t.name }}-in seq 20 permit {{ t.lb_cidr }} ge 32
{% endfor %}
!
{% for t in vm_vlans %}
route-map {{ t.name }}-in permit 10
 match ip address prefix-list {{ t.name }}-in
exit
!
{% endfor %}
route-map deny-all deny 10
exit
!
router bgp {{ fabric_asn }}
 bgp router-id {{ node_ip }}
 bgp log-neighbor-changes
 ! Keep a node's routes while its Cilium agent restarts (session closed
 ! without NOTIFICATION), but not when the hold timer expires: a dead node is
 ! withdrawn after 9s instead of 9s + restart time.
 bgp graceful-restart
 no bgp graceful-restart notification
 no bgp default ipv4-unicast
 bgp listen limit 1000
{% for t in vm_vlans %}
 neighbor {{ t.name }} peer-group
 neighbor {{ t.name }} remote-as {{ t.asn }}
 neighbor {{ t.name }} description workload cluster {{ t.name }} (VLAN {{ t.id }})
 neighbor {{ t.name }} timers 3 9
 bgp listen range {{ t.cidr }} peer-group {{ t.name }}
{% endfor %}
 !
 address-family ipv4 unicast
  ! ECMP: a LoadBalancer IP announced by every node of a cluster.
  maximum-paths 64
{% for t in vm_vlans %}
  neighbor {{ t.name }} activate
  neighbor {{ t.name }} soft-reconfiguration inbound
  ! One pod block + up to 256 LoadBalancer IPs per node.
  neighbor {{ t.name }} maximum-prefix 512
  neighbor {{ t.name }} route-map {{ t.name }}-in in
  neighbor {{ t.name }} route-map deny-all out
{% endfor %}
 exit-address-family
exit
!
